{
  "name": "x-browser-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Local Twitter/X browser automation and research MCP server",
  "repository": {
    "type": "git",
    "url": "https://github.com/Billioncodes001/x-browser-mcp.git"
  },
  "homepage": "https://github.com/Billioncodes001/x-browser-mcp#readme",
  "bugs": {
    "url": "https://github.com/Billioncodes001/x-browser-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "x-browser-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:dashboard",
    "start": "node dist/cli.js serve",
    "login": "node dist/cli.js login",
    "doctor": "node dist/cli.js doctor",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:protocol": "node test/protocol.mjs",
    "check": "npm run build && npm test && npm run test:protocol && npm run test:dashboard",
    "build:server": "tsc -p tsconfig.json",
    "build:dashboard": "tsc -p tsconfig.dashboard.json && vite build",
    "dashboard": "node dist/cli.js dashboard",
    "test:dashboard": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "playwright": "1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
